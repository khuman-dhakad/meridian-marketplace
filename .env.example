# =====================================================================
# MERIDIAN MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env or set these in your deployment environment.
# NEVER commit real credentials, passwords, or session secrets to Git.
# =====================================================================

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://meridian_user:meridian_password@localhost:5432/meridian_db?schema=public"

# Cryptographic Session Secret (Minimum 64 characters recommended for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="meridian_super_secret_development_session_key_replace_in_production_min_64_chars"

# Node Environment
NODE_ENV="development"
